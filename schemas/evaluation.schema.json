{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://primenet.local/primeaiexplorer/schemas/evaluation.schema.json",
    "title":  "PrimeAIExplorer Canonical Evaluation Result",
    "description":  "Canonical schema for a PrimeAIExplorer evaluation result.",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "evaluation_result_id",
                     "evaluation_schema_version",
                     "status",
                     "created_at_utc",
                     "observation",
                     "evaluator",
                     "configuration",
                     "validity",
                     "metrics",
                     "review",
                     "exclusion",
                     "integrity",
                     "environment",
                     "provenance"
                 ],
    "properties":  {
                       "evaluation_result_id":  {
                                                    "type":  "string",
                                                    "pattern":  "^EVR-[0-9]{10}$"
                                                },
                       "evaluation_schema_version":  {
                                                         "type":  "string",
                                                         "pattern":  "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                                                     },
                       "status":  {
                                      "type":  "string",
                                      "enum":  [
                                                   "pending",
                                                   "running",
                                                   "valid",
                                                   "invalid",
                                                   "scored",
                                                   "review_required",
                                                   "reviewed",
                                                   "failed",
                                                   "excluded_with_reason",
                                                   "superseded"
                                               ]
                                  },
                       "created_at_utc":  {
                                              "type":  "string",
                                              "format":  "date-time"
                                          },
                       "started_at_utc":  {
                                              "type":  [
                                                           "string",
                                                           "null"
                                                       ],
                                              "format":  "date-time"
                                          },
                       "completed_at_utc":  {
                                                "type":  [
                                                             "string",
                                                             "null"
                                                         ],
                                                "format":  "date-time"
                                            },
                       "observation":  {
                                           "type":  "object",
                                           "additionalProperties":  false,
                                           "required":  [
                                                            "observation_id",
                                                            "observation_schema_version",
                                                            "response_sha256"
                                                        ],
                                           "properties":  {
                                                              "observation_id":  {
                                                                                     "type":  "string",
                                                                                     "pattern":  "^OBS-[0-9]{10}$"
                                                                                 },
                                                              "observation_schema_version":  {
                                                                                                 "type":  "string",
                                                                                                 "pattern":  "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                                                                                             },
                                                              "response_sha256":  {
                                                                                      "type":  [
                                                                                                   "string",
                                                                                                   "null"
                                                                                               ],
                                                                                      "pattern":  "^[a-fA-F0-9]{64}$"
                                                                                  }
                                                          }
                                       },
                       "evaluator":  {
                                         "type":  "object",
                                         "additionalProperties":  false,
                                         "required":  [
                                                          "evaluator_id",
                                                          "evaluator_version",
                                                          "name",
                                                          "evaluator_type",
                                                          "implementation_version"
                                                      ],
                                         "properties":  {
                                                            "evaluator_id":  {
                                                                                 "type":  "string",
                                                                                 "pattern":  "^EVAL-[0-9]{6}$"
                                                                             },
                                                            "evaluator_version":  {
                                                                                      "type":  "string",
                                                                                      "pattern":  "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                                                                                  },
                                                            "name":  {
                                                                         "type":  "string",
                                                                         "minLength":  1
                                                                     },
                                                            "evaluator_type":  {
                                                                                   "type":  "string",
                                                                                   "enum":  [
                                                                                                "deterministic",
                                                                                                "rule_based",
                                                                                                "statistical",
                                                                                                "rubric_based",
                                                                                                "human_review",
                                                                                                "model_based",
                                                                                                "composite"
                                                                                            ]
                                                                               },
                                                            "implementation_version":  {
                                                                                           "type":  "string",
                                                                                           "pattern":  "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                                                                                       }
                                                        }
                                     },
                       "configuration":  {
                                             "type":  "object",
                                             "additionalProperties":  true,
                                             "required":  [
                                                              "configuration_sha256"
                                                          ],
                                             "properties":  {
                                                                "configuration_sha256":  {
                                                                                             "type":  "string",
                                                                                             "pattern":  "^[a-fA-F0-9]{64}$"
                                                                                         }
                                                            }
                                         },
                       "validity":  {
                                        "type":  "object",
                                        "additionalProperties":  false,
                                        "required":  [
                                                         "is_valid",
                                                         "reason"
                                                     ],
                                        "properties":  {
                                                           "is_valid":  {
                                                                            "type":  "boolean"
                                                                        },
                                                           "reason":  {
                                                                          "type":  [
                                                                                       "string",
                                                                                       "null"
                                                                                   ]
                                                                      }
                                                       }
                                    },
                       "metrics":  {
                                       "type":  "array",
                                       "items":  {
                                                     "type":  "object",
                                                     "additionalProperties":  false,
                                                     "required":  [
                                                                      "metric_id",
                                                                      "name",
                                                                      "role",
                                                                      "value",
                                                                      "unit",
                                                                      "higher_is_better",
                                                                      "status"
                                                                  ],
                                                     "properties":  {
                                                                        "metric_id":  {
                                                                                          "type":  "string",
                                                                                          "pattern":  "^METRIC-[0-9]{6}$"
                                                                                      },
                                                                        "name":  {
                                                                                     "type":  "string",
                                                                                     "minLength":  1
                                                                                 },
                                                                        "role":  {
                                                                                     "type":  "string",
                                                                                     "enum":  [
                                                                                                  "primary",
                                                                                                  "secondary",
                                                                                                  "diagnostic",
                                                                                                  "exploratory",
                                                                                                  "quality_control"
                                                                                              ]
                                                                                 },
                                                                        "value":  {
                                                                                      "type":  [
                                                                                                   "number",
                                                                                                   "integer",
                                                                                                   "string",
                                                                                                   "boolean",
                                                                                                   "null"
                                                                                               ]
                                                                                  },
                                                                        "unit":  {
                                                                                     "type":  [
                                                                                                  "string",
                                                                                                  "null"
                                                                                              ]
                                                                                 },
                                                                        "higher_is_better":  {
                                                                                                 "type":  [
                                                                                                              "boolean",
                                                                                                              "null"
                                                                                                          ]
                                                                                             },
                                                                        "status":  {
                                                                                       "type":  "string",
                                                                                       "enum":  [
                                                                                                    "computed",
                                                                                                    "not_applicable",
                                                                                                    "invalid_input",
                                                                                                    "failed"
                                                                                                ]
                                                                                   },
                                                                        "details":  {
                                                                                        "type":  "object"
                                                                                    }
                                                                    }
                                                 }
                                   },
                       "review":  {
                                      "type":  "object",
                                      "additionalProperties":  true,
                                      "required":  [
                                                       "required",
                                                       "completed"
                                                   ],
                                      "properties":  {
                                                         "required":  {
                                                                          "type":  "boolean"
                                                                      },
                                                         "completed":  {
                                                                           "type":  "boolean"
                                                                       }
                                                     }
                                  },
                       "exclusion":  {
                                         "type":  "object",
                                         "additionalProperties":  false,
                                         "required":  [
                                                          "excluded",
                                                          "reason"
                                                      ],
                                         "properties":  {
                                                            "excluded":  {
                                                                             "type":  "boolean"
                                                                         },
                                                            "reason":  {
                                                                           "type":  [
                                                                                        "string",
                                                                                        "null"
                                                                                    ]
                                                                       }
                                                        }
                                     },
                       "integrity":  {
                                         "type":  "object",
                                         "additionalProperties":  false,
                                         "required":  [
                                                          "algorithm",
                                                          "result_sha256"
                                                      ],
                                         "properties":  {
                                                            "algorithm":  {
                                                                              "type":  "string",
                                                                              "const":  "SHA-256"
                                                                          },
                                                            "result_sha256":  {
                                                                                  "type":  "string",
                                                                                  "pattern":  "^[a-fA-F0-9]{64}$"
                                                                              }
                                                        }
                                     },
                       "environment":  {
                                           "type":  "object",
                                           "additionalProperties":  true,
                                           "required":  [
                                                            "primeaiexplorer_version",
                                                            "python_version",
                                                            "operating_system"
                                                        ],
                                           "properties":  {
                                                              "primeaiexplorer_version":  {
                                                                                              "type":  "string",
                                                                                              "pattern":  "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                                                                                          },
                                                              "python_version":  {
                                                                                     "type":  "string",
                                                                                     "minLength":  1
                                                                                 },
                                                              "operating_system":  {
                                                                                       "type":  "string",
                                                                                       "minLength":  1
                                                                                   }
                                                          }
                                       },
                       "provenance":  {
                                          "type":  "object",
                                          "additionalProperties":  true,
                                          "required":  [
                                                           "source_observation_id",
                                                           "evaluation_timestamp_utc"
                                                       ],
                                          "properties":  {
                                                             "source_observation_id":  {
                                                                                           "type":  "string",
                                                                                           "pattern":  "^OBS-[0-9]{10}$"
                                                                                       },
                                                             "evaluation_timestamp_utc":  {
                                                                                              "type":  "string",
                                                                                              "format":  "date-time"
                                                                                          }
                                                         }
                                      }
                   }
}
