{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Connector Registry Record",
  "type": "object",
  "required": [
    "connector_id",
    "provider",
    "model_id",
    "enabled",
    "pricing_class",
    "implementation"
  ],
  "properties": {
    "connector_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "pricing_class": {
      "enum": [
        "free",
        "paid",
        "local"
      ]
    },
    "implementation": {
      "type": "string",
      "minLength": 1
    },
    "api_key_environment_variable": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}